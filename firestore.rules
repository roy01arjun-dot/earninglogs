rules_version = '2';

// Firestore security rules for Earninglogs.
//
// Deploy from the Firebase console:
//   Firestore Database -> Rules -> paste -> Publish
// or with the CLI:
//   firebase deploy --only firestore:rules
//
// The core rule (a user may only touch their own document tree) is unchanged from what is
// already deployed on work-hours-tracker-9e02b. What is new is that the app now actually
// satisfies it: it signs in with Firebase Auth and writes under the real `request.auth.uid`.
// Previously nothing ever called signIn, so `request.auth` was null, every write was denied,
// and the app quietly fell back to a local file while reporting "Synced".

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- A user's own data ----
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // One document per shift, keyed by the entry's stable uuid.
      match /entries/{entryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEntry();
        allow delete: if isOwner(userId);
      }

      // Payroll preferences (currency, wage defaults, workplaces).
      match /meta/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---- Everything else is denied ----
    // Note: an earlier build also wrote to a top-level `work_log_backups` collection, which no
    // rule ever permitted, so those writes always failed. That collection is no longer used and
    // is intentionally not granted here. If any documents were somehow created there, they can
    // be deleted from the console.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  // Cheap shape check so a malformed or oversized client write cannot poison a user's history.
  function isValidEntry() {
    let d = request.resource.data;
    return d.keys().hasAll(['uuid', 'date', 'hoursWorked', 'updatedAt'])
      && d.uuid is string
      && d.date is string
      && d.date.size() == 10                    // YYYY-MM-DD
      && d.hoursWorked is number
      && d.hoursWorked >= 0
      && d.hoursWorked <= 24
      && d.updatedAt is number
      && (!('note' in d) || d.note.size() <= 2000)
      && (!('deletedAt' in d) || d.deletedAt == null || d.deletedAt is number);
  }
}
