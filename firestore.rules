rules_version = '2';

// Each signed-in user can only read and write their own data.
// Publish in Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /shifts/{shiftId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
